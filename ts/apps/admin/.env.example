# Solana RPC endpoint — canonical name is NEXT_PUBLIC_SOLANA_RPC_URL
# (NEXT_PUBLIC_RPC_ENDPOINT is still accepted as a fallback)
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_BUNKERCASH_MINT=
# Squads v4 governance. Server-side SQUADS_MULTISIG_PUBKEY is preferred;
# NEXT_PUBLIC_SQUADS_MULTISIG_PUBKEY is also accepted to match the web app.
SQUADS_MULTISIG_PUBKEY=
SQUADS_VAULT_INDEX=0
# Optional: member, initiate, vote, or execute. Defaults to member.
ADMIN_SQUADS_REQUIRED_PERMISSION=member
# Optional server-side admin allowlist override.
# For deployed workers, set this in Cloudflare-managed env/secrets instead of wrangler.jsonc.
ADMIN_OVERRIDE_WALLET=
